# Copy to `.env.local` for local overrides.
# Full mock-preview runbook: docs/MOCK-PREVIEW-DEPLOYMENT.md
# Gates: docs/DECISIONS.md ADR-002 / ADR-011 / ADR-013

# ---------------------------------------------------------------------------
# Required for stakeholder / Vercel mock preview builds
# ---------------------------------------------------------------------------

# Must be exactly "true" so `next build` can succeed while mock content exists.
# Preview deploys stay noindex via shouldNoIndex() regardless of this flag.
ALLOW_MOCK_PUBLISH=true

# Optional on preview. Prefer the automatic Vercel deployment URL
# (https://*.vercel.app). Do NOT point this at a production custom domain for
# a mock preview. Falls back to http://localhost:3000 when unset.
# NEXT_PUBLIC_SITE_URL=https://your-project-git-branch-team.vercel.app

# ---------------------------------------------------------------------------
# Must remain UNSET for mock preview (demonstration mode)
# ---------------------------------------------------------------------------

# Do not set LEAD_PROVIDER_URL on mock preview. Leaving it unset keeps the
# trial/contact forms in demonstration mode (local accept only — no live
# delivery). Setting it would select the production adapter placeholder,
# which still fails closed until a real provider is implemented.
# LEAD_PROVIDER_URL=

# ---------------------------------------------------------------------------
# Do not configure for mock preview
# ---------------------------------------------------------------------------

# No analytics / tag-manager / pixel variables belong in mock preview.
# Do not invent NEXT_PUBLIC_*_ANALYTICS, GTM, GA, Meta Pixel, etc. IDs.
# The codebase does not ship analytics integrations for this phase.

# ---------------------------------------------------------------------------
# Local development defaults (when not using Vercel preview)
# ---------------------------------------------------------------------------

# ALLOW_MOCK_PUBLISH=false
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
