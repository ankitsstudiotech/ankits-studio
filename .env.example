# Copy to `.env.local` for local overrides.
# Production launch: docs/HANDOFF.md · docs/LAUNCH-READINESS.md
# Mock preview only: docs/MOCK-PREVIEW-DEPLOYMENT.md

# ---------------------------------------------------------------------------
# Production (indexable V1)
# ---------------------------------------------------------------------------

# Exact production origin — required for correct canonicals, OG, sitemap.
# Production Vercel (no trailing slash):
# NEXT_PUBLIC_SITE_URL=https://ankits-studio.vercel.app

# Must be unset or "false" on real production. "true" forces noindex preview mode.
# ALLOW_MOCK_PUBLISH=false

# Leave unset until a real lead provider exists. Unset is correct for WhatsApp-first V1.
# LEAD_PROVIDER_URL=

# Stage 4A — synthetic art-direction media (local/preview only). Default off.
# NEXT_PUBLIC_ENABLE_SYNTHETIC_MEDIA=false

# Do not invent analytics IDs. The V1 codebase does not ship GA/GTM/pixel integrations.
# ---------------------------------------------------------------------------
# Mock / stakeholder preview only
# ---------------------------------------------------------------------------

# ALLOW_MOCK_PUBLISH=true
# NEXT_PUBLIC_SITE_URL=https://your-project-git-branch-team.vercel.app

# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------

# ALLOW_MOCK_PUBLISH=false
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Google Places API (New) — server-side social proof only
# ---------------------------------------------------------------------------
# Optional. When unset, the homepage shows outbound Google Maps links
# (no review quotes, stars, or counts).
# Never prefix with NEXT_PUBLIC_ — reviews are fetched on the server.
# GOOGLE_PLACES_API_KEY=
